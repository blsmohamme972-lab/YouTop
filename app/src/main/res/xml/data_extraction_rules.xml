<?xml version="1.0" encoding="utf-8"?>
<!-- Lessons can be downloaded again; leaving them out keeps the learning history inside Android's backup size limit. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="content/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="content/" />
    </device-transfer>
</data-extraction-rules>
